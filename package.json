{
  "name": "ggds",
  "private": true,
  "description": "Ghana Government Design System: tokens, CSS, optional JavaScript and reference HTML for government websites.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build:tokens": "node packages/tokens/build.mjs",
    "build:themes": "node packages/themes/build.mjs",
    "build:css": "node packages/css/build.mjs",
    "build:js": "tsc -p packages/js",
    "build:docs": "node docs/build.mjs",
    "build": "pnpm run build:tokens && pnpm run build:themes && pnpm run build:css && pnpm run build:js && pnpm run build:django && pnpm run build:docs",
    "sync:themes": "node packages/themes/sync.mjs",
    "check:themes": "node packages/themes/sync.mjs --check",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:browser": "playwright test",
    "test": "pnpm run build && pnpm run test:django && pnpm run test:unit && pnpm run test:browser",
    "serve": "node scripts/serve.mjs",
    "sync:scenes": "node scripts/sync-scenes.mjs",
    "release": "node scripts/release.mjs",
    "pack:npm": "node scripts/publish-npm.mjs",
    "publish:npm": "node scripts/publish-npm.mjs --publish",
    "build:django": "node packages/django/build.mjs",
    "test:django": "node scripts/test-django.mjs",
    "pack:django": "node scripts/pack-django.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lightningcss": "1.33.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghana-gds/ggds.git"
  },
  "packageManager": "pnpm@12.16.1"
}
