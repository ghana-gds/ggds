{
  "$description": "GGDS design tokens (W3C Design Tokens Community Group format). Source of truth: build.mjs generates dist/tokens.css, dist/tokens.json and dist/compat-site.css. The government blue scale is the approved default; the flag colours are placeholders until an official specification is published.",
  "color": {
    "$type": "color",
    "brand": {
      "$extensions": { "ggds": { "status": "approved", "origin": "The Ministry of Communications logo blue #0090d8, darkened to #005f8f for at least 4.5:1 contrast on white (WCAG 2.2 AA). Chosen as the basis of the government palette on 2026-11-09; formal approval of the national identity is decision D-01." } },
      "900": { "$value": "#00334d", "$description": "Deep surfaces; link hover (13.3:1 on white)" },
      "800": { "$value": "#00496e", "$description": "Card titles and strong accents (9.6:1 on white)" },
      "700": { "$value": "#005f8f", "$description": "Links and main buttons (6.9:1 on white)" },
      "600": { "$value": "#0073ad", "$description": "5.2:1 on white" },
      "500": { "$value": "#0090d8", "$description": "Light blue. 3.5:1 on white: decoration and large text only, never body text or control borders" },
      "100": { "$value": "#dceff9" },
      "50": { "$value": "#f0f8fc" }
    },
    "institution": {
      "$description": "The institution's own colour, set by its theme. Used only on the header line, the institution name, the homepage hero, the footer and its card in a list. Never on links, buttons, form fields or messages.",
      "default": { "$value": "{color.brand.700}", "$description": "The default theme colour (6.9:1 on white)" },
      "deep": { "$value": "#005d8c", "$description": "Darker shade of the default theme, for the hero and footer (7.1:1 under white text)" }
    },
    "flag": {
      "$extensions": { "ggds": { "status": "placeholder", "note": "Confirm against an official specification of the national flag colours (D-01)." } },
      "red": { "$value": "#ce1126" },
      "gold": { "$value": "#fcd116" },
      "green": { "$value": "#006b3f" },
      "black": { "$value": "#000000" }
    },
    "text": {
      "default": { "$value": "#14213d" },
      "muted": { "$value": "#4a5568" },
      "inverse": { "$value": "#ffffff" }
    },
    "link": {
      "default": { "$value": "{color.brand.700}" },
      "hover": { "$value": "{color.brand.900}" },
      "visited": { "$value": "#5b2a86", "$description": "NITA S&A Standard 6.4.14: read links marked by a standard colour convention" }
    },
    "border": {
      "subtle": { "$value": "#d5dbe5", "$description": "Decoration only. Never the only boundary of a control." },
      "strong": { "$value": "#9aa5b8", "$description": "Decoration only (2.5:1). Never the only boundary of a control." },
      "control": { "$value": "#5c6a80", "$description": "Form control boundaries; at least 3:1 on every surface (WCAG 1.4.11)" }
    },
    "surface": {
      "default": { "$value": "#ffffff" },
      "sunken": { "$value": "#f5f7fa" },
      "raised": { "$value": "#ffffff" }
    },
    "status": {
      "success": { "strong": { "$value": "#0d6b3a" }, "subtle": { "$value": "#e8f5ee" } },
      "warning": { "strong": { "$value": "#7a4b00" }, "subtle": { "$value": "#fff6e0" } },
      "danger": { "strong": { "$value": "#b3261e" }, "subtle": { "$value": "#fdecea" } },
      "info": { "strong": { "$value": "#0b5394" }, "subtle": { "$value": "#e8f1fb" } },
      "neutral": { "strong": { "$value": "#4a5568" }, "subtle": { "$value": "#eef1f5" } }
    },
    "focus": {
      "$description": "3px ring in focus.ring with a focus.halo band between it and the element, visible on light and dark surfaces (WCAG 2.4.7, 1.4.11).",
      "ring": { "$value": "#ffbf47" },
      "halo": { "$value": "#0b0c0c" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "Noto Sans", "Ubuntu", "Cantarell", "Helvetica Neue", "Arial", "sans-serif"], "$description": "The fonts already on each device, so nothing extra downloads." },
      "mono": { "$value": ["ui-monospace", "SF Mono", "Cascadia Mono", "Roboto Mono", "Menlo", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "xs": { "$value": "0.8125rem" },
      "sm": { "$value": "0.9375rem" },
      "base": { "$value": "1.0625rem", "$description": "17px reading size" },
      "lg": { "$value": "1.25rem" },
      "xl": { "$value": "1.5rem" },
      "2xl": { "$value": "clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem)" },
      "3xl": { "$value": "clamp(2rem, 1.5rem + 2.2vw, 3rem)" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "bold": { "$value": 700 }
    }
  },
  "line-height": {
    "$type": "number",
    "tight": { "$value": 1.2 },
    "body": { "$value": 1.6 }
  },
  "measure": { "$type": "dimension", "$value": "68ch" },
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "12": { "$value": "3rem" },
    "16": { "$value": "4rem" }
  },
  "size": {
    "$type": "dimension",
    "gutter": { "$value": "clamp(1rem, 0.6rem + 2vw, 2rem)" },
    "content-max": { "$value": "76rem" },
    "target": { "$value": "44px", "$description": "Minimum touch target (exceeds WCAG 2.5.8 AA, 24px)" },
    "icon": {
      "sm": { "$value": "1rem" },
      "md": { "$value": "1.25rem" },
      "lg": { "$value": "1.5rem" },
      "xl": { "$value": "2rem" }
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "14px" },
    "pill": { "$value": "999px" },
    "round": { "$value": "50%" },
    "sheet": { "$value": "18px", "$description": "Top corners of a bottom sheet on phones." }
  },
  "shadow": {
    "$type": "shadow",
    "1": { "$value": "0 1px 2px rgb(20 33 61 / 0.08), 0 1px 3px rgb(20 33 61 / 0.06)" },
    "2": { "$value": "0 4px 12px rgb(20 33 61 / 0.1), 0 2px 4px rgb(20 33 61 / 0.06)" },
    "sheet": { "$value": "0 -8px 32px rgb(20 33 61 / 0.18)", "$description": "A bottom sheet over the page on phones." }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Collapsed to 0ms under prefers-reduced-motion.",
      "fast": { "$value": "120ms" },
      "base": { "$value": "220ms" },
      "slow": { "$value": "360ms" },
      "stagger": { "$value": "40ms", "$description": "Delay between items that appear one after another." }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0, 0, 1] },
      "enter": { "$value": [0.16, 1, 0.3, 1] },
      "spring": { "$value": [0.34, 1.56, 0.64, 1], "$description": "A small overshoot: a pressed button springs back." }
    }
  },
  "layer": {
    "$type": "number",
    "$description": "z-index scale. Use these, never raw numbers.",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "sticky": { "$value": 100 },
    "overlay": { "$value": 400 },
    "modal": { "$value": 500 },
    "toast": { "$value": 600 }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "Custom properties cannot be used in @media; component CSS uses these literal values and a unit test rejects any other.",
    "tablet": { "$value": "48rem" },
    "desktop": { "$value": "64rem" },
    "wide": { "$value": "80rem", "$description": "From this width the header shows its sections in one row beside the name." }
  },
  "$extensions": {
    "ggds": {
      "contrastPairs": [
        { "fg": "color.text.default", "bg": "color.surface.default", "min": 4.5, "group": "Text", "label": "Body text on the page" },
        { "fg": "color.text.default", "bg": "color.surface.sunken", "min": 4.5, "group": "Text", "label": "Body text on a grey panel" },
        { "fg": "color.text.muted", "bg": "color.surface.default", "min": 4.5, "group": "Text", "label": "Hints and secondary text on the page" },
        { "fg": "color.text.muted", "bg": "color.surface.sunken", "min": 4.5, "group": "Text", "label": "Hints and secondary text on a grey panel" },
        { "fg": "color.text.muted", "bg": "color.brand.50", "min": 4.5, "group": "Text", "label": "Secondary text on a light blue panel" },
        { "fg": "color.link.default", "bg": "color.surface.default", "min": 4.5, "group": "Links", "label": "A link on the page" },
        { "fg": "color.link.default", "bg": "color.surface.sunken", "min": 4.5, "group": "Links", "label": "A link on a grey panel" },
        { "fg": "color.link.hover", "bg": "color.surface.default", "min": 4.5, "group": "Links", "label": "A link under the pointer" },
        { "fg": "color.link.visited", "bg": "color.surface.default", "min": 4.5, "group": "Links", "label": "A link already visited" },
        { "fg": "color.text.inverse", "bg": "color.brand.700", "min": 4.5, "group": "Links", "label": "White text on a main button" },
        { "fg": "color.text.inverse", "bg": "color.institution.deep", "min": 7, "group": "Your institution’s colours", "label": "White text on the hero and footer" },
        { "fg": "color.flag.gold", "bg": "color.institution.deep", "min": 4.5, "group": "Your institution’s colours", "label": "The gold purpose line on the hero" },
        { "fg": "color.institution.default", "bg": "color.surface.default", "min": 4.5, "group": "Your institution’s colours", "label": "Your institution’s name in the header" },
        { "fg": "color.border.control", "bg": "color.surface.default", "min": 3, "group": "Forms and focus", "label": "The border of a form field" },
        { "fg": "color.border.control", "bg": "color.surface.sunken", "min": 3, "group": "Forms and focus", "label": "The border of a form field on a grey panel" },
        { "fg": "color.status.success.strong", "bg": "color.status.success.subtle", "min": 4.5, "group": "Messages", "label": "A success message" },
        { "fg": "color.text.inverse", "bg": "color.status.success.strong", "min": 4.5, "group": "Messages", "label": "White text on a confirmation panel" },
        { "fg": "color.status.warning.strong", "bg": "color.status.warning.subtle", "min": 4.5, "group": "Messages", "label": "A warning message" },
        { "fg": "color.status.danger.strong", "bg": "color.status.danger.subtle", "min": 4.5, "group": "Messages", "label": "A danger message" },
        { "fg": "color.status.danger.strong", "bg": "color.surface.default", "min": 4.5, "group": "Messages", "label": "An error message under a form field" },
        { "fg": "color.status.info.strong", "bg": "color.status.info.subtle", "min": 4.5, "group": "Messages", "label": "An information message" },
        { "fg": "color.status.neutral.strong", "bg": "color.status.neutral.subtle", "min": 4.5, "group": "Messages", "label": "A neutral tag" },
        { "fg": "color.focus.ring", "bg": "color.focus.halo", "min": 3, "group": "Forms and focus", "label": "The focus outline against its glow" },
        { "fg": "color.focus.halo", "bg": "color.surface.default", "min": 3, "group": "Forms and focus", "label": "The focus glow on the page" },
        { "fg": "color.text.default", "bg": "color.brand.100", "min": 4.5, "group": "Text", "label": "Body text on a selected item" }
      ]
    }
  }
}
