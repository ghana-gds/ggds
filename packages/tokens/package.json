{
  "name": "@ggds/tokens",
  "version": "0.3.0",
  "description": "Design tokens for the Ghana Government Design System (GGDS): colours, type and spacing as CSS custom properties and W3C DTCG JSON, with the institution colour rule.",
  "author": "Ghana Government Design System (GGDS) contributors",
  "keywords": [
    "ghana",
    "government",
    "design-system",
    "ggds",
    "accessibility",
    "gov",
    "design-tokens",
    "dtcg",
    "css-custom-properties"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ghana-gds/ggds/tree/main/packages/tokens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghana-gds/ggds.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/ghana-gds/ggds/issues"
  },
  "type": "module",
  "files": [
    "tokens.json",
    "lib.mjs",
    "institution.mjs",
    "dist"
  ],
  "exports": {
    "./tokens.json": "./tokens.json",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.flat.json": "./dist/tokens.json",
    "./compat-site.css": "./dist/compat-site.css",
    "./lib.mjs": "./lib.mjs",
    "./institution.mjs": "./institution.mjs",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "prepack": "node ../../scripts/package-files.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
