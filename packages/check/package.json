{
  "name": "@ggds/check",
  "version": "0.5.0",
  "description": "Checks a Government of Ghana website, or its built pages, for what every government website needs: the GGDS page parts, accessibility, security headers, the email domain and speed. Each result names its published source.",
  "author": "Ghana Government Design System (GGDS) contributors",
  "keywords": [
    "ghana",
    "government",
    "design-system",
    "ggds",
    "accessibility",
    "gov",
    "audit",
    "security-headers",
    "wcag"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ghana-gds/ggds/tree/main/packages/check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghana-gds/ggds.git",
    "directory": "packages/check"
  },
  "bugs": {
    "url": "https://github.com/ghana-gds/ggds/issues"
  },
  "type": "module",
  "files": [
    "check.mjs",
    "rules.mjs",
    "placeholders.json"
  ],
  "bin": {
    "ggds-check": "./check.mjs"
  },
  "exports": {
    ".": "./check.mjs",
    "./rules": "./rules.mjs",
    "./placeholders.json": "./placeholders.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@axe-core/playwright": ">=4.9",
    "@playwright/test": ">=1.45"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  },
  "scripts": {
    "prepack": "node ../../scripts/package-files.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
