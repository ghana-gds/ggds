---
/** GGDS skip link: the first thing on every page. Point it at <main id="main" tabindex="-1">. */
interface Props { href?: string | undefined; label?: string | undefined }
const { href = '#main', label = 'Skip to main content' } = Astro.props;
---
<a class="ggds-skip-link" href={href}>{label}</a>
