---
/** GGDS skip link: the first thing on every page. Point it at <main id="main" tabindex="-1">. */
import { STRINGS } from './strings.mjs';

interface Props { href?: string | undefined; label?: string | undefined; strings?: Record<string, string> | undefined }
const { href = '#main', label, strings } = Astro.props;
const s = { ...STRINGS, ...strings };
---
<a class="ggds-skip-link" href={href}>{label ?? s['skipLink.label']}</a>
