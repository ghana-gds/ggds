---
/**
 * GGDS government website banner. Works without JavaScript (<details>), never sticky.
 * official: this page is served from the official address. host: the official address to name ("" when there is
 * none the banner may name). register: the list of official government websites to check against.
 */
interface Props {
  official?: boolean | undefined;
  shortName: string;
  host: string;
  addressNote?: string | undefined;
  register?: { href: string; label?: string | undefined } | null;
  /** GGDS's own text in another language (stringsFor('tw') from @ggds/astro/strings.mjs) or other words, by key. */
  strings?: Record<string, string> | undefined;
  class?: string | undefined;
  [attr: string]: unknown;
}
import { STRINGS, fillHtml } from './strings.mjs';
const { official = false, shortName, host, addressNote = '', register = null, strings, class: extra = '', ...rest } = Astro.props;
const s = { ...STRINGS, ...strings };
const strong = (x: string) => `<strong>${fillHtml('{x}', {}, { x })}</strong>`;
const address = !host ? fillHtml(s['banner.noAddress'], {}, { shortName })
  : official ? fillHtml(s['banner.officialAddress'], { host: strong(host) })
    : fillHtml(s['banner.otherAddress'], { host: strong(host) }, { shortName, note: addressNote });
const registerHtml = register ? fillHtml(s['banner.register'], { register: `<a href="${fillHtml('{x}', {}, { x: register.href })}">${fillHtml('{x}', {}, { x: register.label ?? s['banner.registerLabel'] })}</a>` }) : '';
---
<section class:list={['ggds-banner', !official && 'ggds-banner--unofficial', extra]} aria-label={s['banner.label']} {...rest}>
  <details class="ggds-banner__details ggds-container">
    <summary class="ggds-banner__summary">
      <svg class="ggds-banner__flag" viewBox="0 0 30 20" aria-hidden="true" focusable="false"><rect class="ggds-banner__flag-red" width="30" height="6.67"/><rect class="ggds-banner__flag-gold" y="6.67" width="30" height="6.67"/><rect class="ggds-banner__flag-green" y="13.33" width="30" height="6.67"/><polygon class="ggds-banner__flag-star" points="15,6.8 15.73,8.99 18.04,9.01 16.19,10.39 16.88,12.59 15,11.25 13.12,12.59 13.81,10.39 11.96,9.01 14.27,8.99"/></svg>
      <span class="ggds-banner__text">{official ? s['banner.official'] : s['banner.unofficial'].replace('{shortName}', shortName)}</span>
      {' '}<span class="ggds-banner__toggle">{s['banner.howToTell']}</span>
    </summary>
    <div class="ggds-banner__content">
      <div class="ggds-banner__item">
        <p class="ggds-banner__heading">{s['banner.checkAddress']}</p>
        <p set:html={`${address} ${fillHtml(s['banner.domain'], { domain: '<strong>.gov.gh</strong>' })}${registerHtml ? ` ${registerHtml}` : ''}`} />
      </div>
      <div class="ggds-banner__item">
        <p class="ggds-banner__heading">{s['banner.padlockHeading']}</p>
        <p set:html={fillHtml(s['banner.padlock'], { https: '<strong>https://</strong>' })} />
      </div>
      <div class="ggds-banner__item">
        <p class="ggds-banner__heading">{s['banner.pinHeading']}</p>
        <p>{s['banner.pin']}</p>
      </div>
    </div>
  </details>
</section>
