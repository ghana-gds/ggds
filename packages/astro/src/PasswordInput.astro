---
/**
 * GGDS password input: a password field with a Show button, which @ggds/js shows and runs (the words come from
 * strings, in the page's language). autocomplete: current-password to sign in (default), new-password to create one.
 */
import { STRINGS } from './strings.mjs';
interface Props {
  id: string; name: string; label: string; hint?: string | undefined; error?: string | undefined;
  autocomplete?: 'current-password' | 'new-password' | undefined; strings?: Record<string, string> | undefined;
}
const { id, name, label, hint, error, autocomplete = 'current-password', strings } = Astro.props;
const s = { ...STRINGS, ...strings };
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---
<div class={error ? 'ggds-field ggds-field--error ggds-password-input' : 'ggds-field ggds-password-input'} data-ggds-module="password-input"
  data-ggds-show={s['passwordInput.show']} data-ggds-hide={s['passwordInput.hide']} data-ggds-show-label={s['passwordInput.showLabel']}
  data-ggds-hide-label={s['passwordInput.hideLabel']} data-ggds-shown={s['passwordInput.shown']} data-ggds-hidden={s['passwordInput.hidden']}>
  <label class="ggds-label" for={id}>{label}</label>
  {hint && <p class="ggds-hint" id={`${id}-hint`}>{hint}</p>}
  {error && <p class="ggds-error-message" id={`${id}-error`}><span class="ggds-visually-hidden">{s['field.errorPrefix'].trimEnd()}</span> {error}</p>}
  <div class="ggds-password-input__wrapper">
    <input class="ggds-input ggds-password-input__input" id={id} name={name} type="password" autocomplete={autocomplete} spellcheck="false" autocapitalize="none" aria-describedby={describedBy} aria-invalid={error ? 'true' : undefined} />
    <button class="ggds-button ggds-button--secondary ggds-password-input__toggle" type="button" aria-controls={id} aria-label={s['passwordInput.showLabel']} hidden>{s['passwordInput.show']}</button>
  </div>
</div>
