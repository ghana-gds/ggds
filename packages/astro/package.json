{
  "name": "@ggds/astro",
  "version": "0.4.0",
  "description": "Astro components for the Ghana Government Design System (GGDS): skip link, banner, header, hero, footer and tab bar.",
  "author": "Ghana Government Design System (GGDS) contributors",
  "keywords": [
    "ghana",
    "government",
    "design-system",
    "ggds",
    "accessibility",
    "gov",
    "astro",
    "astro-component",
    "withastro",
    "astro-components"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ghana-gds/ggds/tree/main/packages/astro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghana-gds/ggds.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/ghana-gds/ggds/issues"
  },
  "type": "module",
  "exports": {
    "./*.astro": "./src/*.astro",
    "./icons.mjs": "./icons.mjs",
    "./strings.mjs": "./src/strings.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "icons.mjs"
  ],
  "dependencies": {
    "@ggds/icons": "workspace:^"
  },
  "peerDependencies": {
    "astro": ">=5",
    "@ggds/css": "workspace:^"
  },
  "scripts": {
    "prepack": "node ../../scripts/package-files.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
