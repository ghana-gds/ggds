{
  "name": "@ggds/js",
  "version": "0.2.0",
  "description": "Optional script for the Ghana Government Design System (GGDS): the phone menu and error summary focus. ES modules, no dependencies, CSP-safe.",
  "author": "Ghana Government Design System (GGDS) contributors",
  "keywords": [
    "ghana",
    "government",
    "design-system",
    "ggds",
    "accessibility",
    "gov",
    "progressive-enhancement",
    "csp"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ghana-gds/ggds/tree/main/packages/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghana-gds/ggds.git",
    "directory": "packages/js"
  },
  "bugs": {
    "url": "https://github.com/ghana-gds/ggds/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": "./dist/auto.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/auto.js"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-files.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
