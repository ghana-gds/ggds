{
  "name": "@ggds/themes",
  "version": "0.4.0",
  "description": "Institution themes for the Ghana Government Design System (GGDS): the ministry and each agency, as CSS and data. Identity colours only.",
  "author": "Ghana Government Design System (GGDS) contributors",
  "keywords": [
    "ghana",
    "government",
    "design-system",
    "ggds",
    "accessibility",
    "gov",
    "themes",
    "css"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ghana-gds/ggds/tree/main/packages/themes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghana-gds/ggds.git",
    "directory": "packages/themes"
  },
  "bugs": {
    "url": "https://github.com/ghana-gds/ggds/issues"
  },
  "type": "module",
  "bin": {
    "ggds-themes": "./cli.mjs"
  },
  "files": [
    "themes.json",
    "index.mjs",
    "cli.mjs",
    "dist"
  ],
  "exports": {
    ".": "./index.mjs",
    "./themes.json": "./dist/themes.json",
    "./themes.css": "./dist/themes.css",
    "./*.css": "./dist/*.css",
    "./tokens/*.tokens.json": "./dist/tokens/*.tokens.json",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ggds/tokens": "workspace:^"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepack": "node ../../scripts/package-files.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
