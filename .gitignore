node_modules/
dist/
packages/react/demo-dist/
site/
test-results/
playwright-report/
.DS_Store

# Copied into each package when it is packed (scripts/package-files.mjs)
packages/*/LICENSE
packages/*/LICENSE.md

# Release files (scripts/release.mjs)
release/

# ggds-django: its Python environment, and the files build.mjs copies in (pnpm run build)
packages/django/.venv/
packages/django/src/ggds_django/static/
packages/django/src/ggds_django/icons.json
__pycache__/

# ggds-wordpress: the files build.mjs copies in (pnpm run build)
packages/wordpress/ggds/assets/
packages/wordpress/ggds/LICENSE
packages/wordpress/ggds/LICENSE.md
packages/react/.typecheck/
.starter-build/

# GGDS's own text, generated from packages/html/strings/ (pnpm run build:strings)
packages/react/src/strings.ts
packages/astro/src/strings.mjs
packages/django/src/ggds_django/strings.json
packages/django/src/ggds_django/locale/
packages/astro/.render-test/

# GGDS Switch: its copy of the theme (packages/wordpress/build.mjs)
packages/wordpress/ggds-switch/theme/
packages/wordpress/ggds-switch/placeholders.json
packages/wordpress/ggds-switch/LICENSE
packages/wordpress/ggds-switch/LICENSE.md
